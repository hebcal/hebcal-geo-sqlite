#!/bin/sh

set -e
set -x

# Resolve the real location of this script (node_modules/.bin entries and
# npx installs are symlinks) so we can find the package's own files no matter
# which directory we are invoked from.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK=`readlink "$SELF"`
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="`dirname "$SELF"`/$LINK" ;;
  esac
done
PKGDIR=`cd "\`dirname "$SELF"\`/.." && pwd -P`

# output databases are written to the current working directory
CURDIR=`pwd`

WORKDIR=`mktemp -d "${TMPDIR:-/tmp}/geonames.XXXXXX"`
trap 'rm -rf "$WORKDIR"' EXIT

# optionally specify minimum city population size with POPULATION=750
POPULATION=${POPULATION:-"0"}

# optionally specify a geonames export file such as cities500 or cities5000
CITIES=${CITIES:-"cities1000"}

curl -f --compressed -o "$WORKDIR/countryInfo.txt" http://download.geonames.org/export/dump/countryInfo.txt
curl -f --compressed -o "$WORKDIR/admin1CodesASCII.txt" http://download.geonames.org/export/dump/admin1CodesASCII.txt
curl -f -o "$WORKDIR/$CITIES.zip" "http://download.geonames.org/export/dump/$CITIES.zip"
curl -f -o "$WORKDIR/IL.zip" http://download.geonames.org/export/dump/IL.zip
curl -f -o "$WORKDIR/alt-IL.zip" http://download.geonames.org/export/dump/alternatenames/IL.zip

cd "$WORKDIR"
unzip "$CITIES.zip"
unzip alt-IL.zip
mv IL.txt alt-IL.txt
rm -f readme.txt
unzip IL.zip

cd "$CURDIR"

node "$PKGDIR/bin/build-geonames-sqlite" \
  --population="$POPULATION" \
  "$CURDIR/geonames.sqlite3" \
  "$WORKDIR/countryInfo.txt" \
  "$WORKDIR/$CITIES.txt" \
  "$PKGDIR/cities-patch.txt" \
  "$WORKDIR/admin1CodesASCII.txt" \
  "$WORKDIR/IL.txt" \
  "$WORKDIR/alt-IL.txt"

node "$PKGDIR/bin/make-zips-sqlite" \
  "$CURDIR/zips.sqlite3" \
  "$PKGDIR/zips-dummy.sql"

ls -lh "$CURDIR/geonames.sqlite3" "$CURDIR/zips.sqlite3"
